---
/** A product screenshot (dark variant), optimized to responsive WebP at build time. */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  class?: string;
  loading?: 'eager' | 'lazy';
  hidden?: boolean;
}

const { src, alt, sizes, class: className, loading = 'lazy' } = Astro.props;
const widths = (Astro.props.widths ?? [480, 800, 1200, 1600, 2000, 2560]).filter((w) => w <= src.width);
if (widths.length === 0) widths.push(src.width);

const img = await getImage({ src, widths, sizes, format: 'webp', quality: 82 });
---

<img
  src={img.src}
  srcset={img.srcSet.attribute}
  sizes={sizes}
  alt={alt}
  width={src.width}
  height={src.height}
  loading={loading}
  decoding="async"
  class:list={['block h-auto', className]}
/>
