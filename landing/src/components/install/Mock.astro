---
/**
 * Small illustrations for the install guide, drawn in HTML/CSS (not screenshots of any browser).
 * They are decorative: the step text carries the instructions. Styles: "Install guide mocks" in global.css.
 */
import Icon from '../Icon.astro';
import For from './For.astro';
import { browsers } from '../../browsers';
import { downloads } from '../../downloads';
import { toLocale, useStrings } from '../../i18n';

interface Props {
  kind: 'download' | 'unzip' | 'open' | 'devmode' | 'load' | 'pin' | 'flags' | 'firstrun' | 'claude';
}
const { kind } = Astro.props;
// Mock UI labels stay in English (the browser and extension UI); only the hand-drawn annotations are translated.
const t = useStrings(toLocale(Astro.currentLocale)).guide.mock;
const url = browsers.map((b) => ({ b: b.id, text: b.extensionsUrl }));
---

{
  kind === 'download' && (
    <div class="mk-win">
      <div class="mk-bar">
        <span class="mk-dots"><i /><i /><i /></span>
        <span class="mk-url">answeronce · install</span>
        <span class="mk-tool mk-hot"><Icon name="Download" class="size-3.5" /></span>
      </div>
      <div class="mk-body mk-page">
        <span class="mk-line w-1/2" />
        <span class="mk-line w-3/4" />
        <span class="mk-line w-2/3" />
        <div class="mk-pop">
          <p class="mk-pop-title">Recent downloads</p>
          <div class="mk-dl">
            <span class="mk-zip" />
            <span class="min-w-0">
              <span class="mk-strong block truncate">{downloads.extension.file}</span>
              <span class="block text-[0.6875rem] text-muted">{downloads.extension.size || 'zip'} · Done</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  )
}

{
  kind === 'unzip' && (
    <div class="mk-win">
      <div class="mk-bar">
        <span class="mk-dots"><i /><i /><i /></span>
        <span class="mk-title">Documents</span>
      </div>
      <div class="mk-body mk-unzip">
        <figure class="mk-file">
          <span class="mk-zip mk-zip-lg" />
          <figcaption>answeronce-chrome.zip</figcaption>
        </figure>
        <span class="mk-arrow">
          <Icon name="ArrowRight" class="size-4" />
          <span>{t.doubleClick}</span>
        </span>
        <figure class="mk-file mk-file-selected">
          <span class="mk-folder mk-folder-lg" />
          <figcaption>answeronce-chrome</figcaption>
        </figure>
      </div>
    </div>
  )
}

{
  kind === 'open' && (
    <div class="mk-win">
      <div class="mk-bar">
        <span class="mk-dots"><i /><i /><i /></span>
        <span class="mk-url mk-url-focus">
          {url.map((u) => (
            <For b={u.b}>{u.text}</For>
          ))}
          <span class="mk-caret" />
        </span>
        <span class="mk-key">Enter ↵</span>
      </div>
      <div class="mk-body mk-page">
        <span class="mk-line w-1/3" />
        <span class="mk-line w-full" />
        <span class="mk-line w-5/6" />
        <span class="mk-line w-2/3" />
      </div>
    </div>
  )
}

{
  kind === 'devmode' && (
    <div class="mk-win">
      <div class="mk-bar">
        <span class="mk-dots"><i /><i /><i /></span>
        <span class="mk-url">
          {url.map((u) => (
            <For b={u.b}>{u.text}</For>
          ))}
        </span>
      </div>
      <For b="chrome arc brave" block>
        <div class="mk-ext-head">
          <span class="mk-strong">Extensions</span>
          <span class="mk-dev mk-ring">
            Developer mode
            <span class="mk-toggle" />
          </span>
        </div>
        <div class="mk-body mk-page">
          <span class="mk-cardline" />
          <span class="mk-cardline" />
        </div>
      </For>
      <For b="edge" block>
        <div class="mk-edge">
          <div class="mk-edge-side">
            <span class="mk-strong">Extensions</span>
            <span class="mk-line w-3/4" />
            <span class="mk-line w-2/3" />
            <span class="mk-dev mk-ring">
              Developer mode
              <span class="mk-toggle" />
            </span>
          </div>
          <div class="mk-body mk-page flex-1">
            <span class="mk-cardline" />
            <span class="mk-cardline" />
          </div>
        </div>
      </For>
    </div>
  )
}

{
  kind === 'load' && (
    <div class="mk-stack">
      <div class="mk-win">
        <div class="mk-btnrow">
          <span class="mk-btn mk-btn-hot">Load unpacked</span>
          <span class="mk-btn">Pack extension</span>
          <span class="mk-btn max-[420px]:hidden">Update</span>
        </div>
      </div>
      <div class="mk-picker">
        <div class="mk-bar">
          <span class="mk-dots"><i /><i /><i /></span>
          <span class="mk-title">Documents</span>
        </div>
        <div class="mk-picker-body">
          <ul class="mk-picker-side">
            <li>Desktop</li>
            <li class="is-active">Documents</li>
            <li>Downloads</li>
          </ul>
          <ul class="mk-picker-list">
            <li class="is-selected">
              <span class="mk-folder" />
              answeronce-chrome
            </li>
            <li>
              <span class="mk-folder" />
              Invoices
            </li>
            <li>
              <span class="mk-zip mk-zip-sm" />
              answeronce-chrome.zip
            </li>
          </ul>
        </div>
        <div class="mk-picker-foot">
          <span class="mk-btn">Cancel</span>
          <span class="mk-btn mk-btn-primary">Select</span>
        </div>
      </div>
    </div>
  )
}

{
  kind === 'pin' && (
    <div class="mk-win">
      <div class="mk-bar">
        <span class="mk-dots"><i /><i /><i /></span>
        <span class="mk-url">jobs.example.com/apply</span>
        <span class="mk-tool mk-hot"><Icon name="Puzzle" class="size-3.5" /></span>
      </div>
      <div class="mk-body mk-page mk-pin-wrap">
        <span class="mk-line w-1/2" />
        <span class="mk-line w-3/4" />
        <div class="mk-pop">
          <p class="mk-pop-title">Extensions</p>
          <div class="mk-menu-row">
            <img src="/favicon.svg" alt="" width="16" height="16" class="size-4 rounded-[4px]" />
            <span class="mk-strong flex-1">AnswerOnce</span>
            <span class="mk-pin mk-ring">
              <For b="chrome arc brave"><Icon name="Pin" class="size-3.5" /></For>
              <For b="edge"><Icon name="Eye" class="size-3.5" /></For>
            </span>
          </div>
          <div class="mk-menu-row opacity-50">
            <span class="size-4 rounded-[4px] bg-surface-2 ring-1 ring-line" />
            <span class="flex-1">Another extension</span>
            <span class="mk-pin"><Icon name="Pin" class="size-3.5" /></span>
          </div>
        </div>
      </div>
    </div>
  )
}

{
  kind === 'flags' && (
    <div class="mk-win">
      <div class="mk-bar">
        <span class="mk-dots"><i /><i /><i /></span>
        <span class="mk-url">brave://flags</span>
      </div>
      <div class="mk-body mk-page">
        <span class="mk-search">
          <Icon name="Search" class="size-3" />
          File System Access API
        </span>
        <div class="mk-flag mk-ring">
          <span class="grid min-w-0 flex-1 gap-1.5">
            <span class="mk-strong truncate">File System Access API</span>
            <span class="mk-line w-3/4" />
          </span>
          <span class="mk-select">
            Enabled
            <Icon name="ChevronDown" class="size-3" />
          </span>
        </div>
        <div class="mk-flag-foot">
          <span class="mk-line w-1/2" />
          <span class="mk-btn mk-btn-primary">Relaunch</span>
        </div>
      </div>
    </div>
  )
}

{
  kind === 'firstrun' && (
    <div class="mk-win">
      <div class="mk-bar">
        <span class="mk-dots"><i /><i /><i /></span>
        <span class="mk-url">jobs.example.com/apply</span>
        <span class="mk-tool mk-hot"><img src="/favicon.svg" alt="" width="14" height="14" class="size-3.5 rounded-[3px]" /></span>
      </div>
      <div class="mk-split">
        <div class="mk-body mk-page flex-1">
          <span class="mk-line w-2/3" />
          <span class="mk-field" />
          <span class="mk-field" />
          <span class="mk-field" />
        </div>
        <div class="mk-panel">
          <span class="flex items-center gap-1.5">
            <img src="/favicon.svg" alt="" width="16" height="16" class="size-4 rounded-[4px]" />
            <span class="mk-strong">Welcome to AnswerOnce</span>
          </span>
          <ol class="mk-mini-steps">
            <li>Choose a folder</li>
            <li>Create profile</li>
            <li>Import your CV</li>
          </ol>
          <span class="mk-btn mk-btn-primary mk-ring w-full">
            <Icon name="FolderOpen" class="size-3" />
            Choose folder…
          </span>
        </div>
      </div>
    </div>
  )
}

{
  kind === 'claude' && (
    <div class="mk-unzip mk-claude">
      <figure class="mk-file">
        <span class="mk-doc">
          <span>.mcpb</span>
        </span>
        <figcaption>answeronce.mcpb</figcaption>
      </figure>
      <span class="mk-arrow">
        <Icon name="ArrowRight" class="size-4" />
        <span>{t.open}</span>
      </span>
      <div class="mk-install">
        <p class="text-[0.6875rem] text-muted">Claude Desktop</p>
        <span class="mt-1.5 flex items-center gap-1.5">
          <img src="/favicon.svg" alt="" width="16" height="16" class="size-4 rounded-[4px]" />
          <span class="mk-strong">AnswerOnce</span>
        </span>
        <span class="mk-line mt-2 w-full" />
        <span class="mk-btn mk-btn-primary mk-ring mt-2.5 w-full">Install</span>
      </div>
    </div>
  )
}
