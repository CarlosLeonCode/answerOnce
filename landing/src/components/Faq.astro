---
import Icon from './Icon.astro';
import { toLocale, useStrings } from '../i18n';

const t = useStrings(toLocale(Astro.currentLocale)).faq;
const faqs = t.items;
---

<section id="faq" class="section-pad relative pt-4 sm:pt-6" aria-labelledby="faq-title">
  <div class="container-page grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
    <div data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="faq-title" class="display display-md mt-4"><span class="dim">{t.titleDim}</span><br />{t.title}</h2>
      <p class="lead mt-4">{t.lead}</p>
    </div>

    <div class="card divide-y divide-line overflow-hidden" data-reveal>
      {
        faqs.map((f, i) => (
          <details class="group" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium transition-colors hover:bg-surface-2 sm:px-6 [&::-webkit-details-marker]:hidden">
              {f.q}
              <Icon name="ChevronDown" class="size-5 flex-none text-muted transition-transform group-open:rotate-180" />
            </summary>
            <p class="px-5 pb-5 text-[0.9375rem] leading-relaxed text-muted sm:px-6">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
