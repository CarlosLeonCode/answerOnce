---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { tools } from '../tools';
import { toLocale, useStrings } from '../i18n';

const locale = toLocale(Astro.currentLocale);
const s = useStrings(locale);
const t = s.tools;
---

<section id="tools" class="relative pb-16 sm:pb-20" aria-labelledby="tools-title">
  <div class="container-page">
    <div class="tools-panel" data-reveal>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
        <div>
          <p class="pill">
            <Icon name="Sparkles" class="size-3.5 flex-none text-accent" />
            {s.nav.tools}
          </p>
          <h2 id="tools-title" class="display display-md mt-3">{t.title}</h2>
        </div>
        <p class="max-w-xs text-[0.9375rem] text-muted sm:text-right">{t.lead}</p>
      </div>

      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {
          tools.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener" class="tool-card group">
                <Image src={p.icon} alt="" width={48} height={48} class="size-11 flex-none rounded-xl border border-line lg:size-12" />
                <span class="block min-w-0 lg:mt-3">
                  <span class="block font-medium text-fg">{p.name}</span>
                  <span class="mt-0.5 block text-sm leading-snug text-muted">{p.text[locale]}</span>
                </span>
                <Icon name="ArrowUpRight" class="absolute top-3 right-3 size-4 text-muted transition-[color,transform] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
