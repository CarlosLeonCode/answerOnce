---
import Icon from './Icon.astro';
import { toLocale, useStrings } from '../i18n';

const t = useStrings(toLocale(Astro.currentLocale)).privacy;
const icons = ['HardDrive', 'AppWindow', 'Sparkles'] as const;
---

<section id="privacy" class="section-pad relative" aria-labelledby="privacy-title">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow justify-center"><Icon name="ShieldCheck" class="size-4" />{t.eyebrow}</p>
      <h2 id="privacy-title" class="display display-lg mt-4">
        <span class="dim">{t.titleDim}</span>{' '}{t.titleBefore}{' '}<span class="glow-u">{t.titleGlow}</span>{t.titleAfter}
      </h2>
      <p class="lead mx-auto mt-5 max-w-[38rem]">{t.lead}</p>
    </div>

    <ul class="mt-12 grid gap-4 md:grid-cols-3" data-reveal>
      {
        t.cards.map((c, i) => (
          <li class="card flex flex-col p-6">
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name={icons[i]} />
              </span>
              <div>
                <p class="text-[0.6875rem] font-medium tracking-[0.14em] text-muted uppercase">{c.kicker}</p>
                <h3 class="font-medium">{c.title}</h3>
              </div>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-fg-2">
              {c.body}
              {i === 2 && (
                <>
                  {' '}
                  <span class="font-medium text-success">{t.local}</span>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="mx-auto mt-6 max-w-4xl text-center text-sm leading-relaxed text-muted" data-reveal>
      <Icon name="KeySquare" class="mr-1.5 inline size-4 align-[-3px] text-accent" />
      {t.permissions}
    </p>
  </div>
</section>
