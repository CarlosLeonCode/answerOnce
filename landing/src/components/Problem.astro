---
import Icon from './Icon.astro';
import FormSkeleton from './FormSkeleton.astro';
import { toLocale, useStrings } from '../i18n';

const t = useStrings(toLocale(Astro.currentLocale)).problem;

/**
 * Fields torn from four fictional application forms. Every label is a phrasing the generic matcher
 * recognizes (src/domain/synonyms.ts), in English and Spanish.
 * x/y: scattered position, normalized to -1..1 around the viewport center. r: tilt in degrees.
 */
const frags = [
  {
    host: 'jobs.northwind.example',
    style: 'boxed',
    x: -0.78,
    y: -0.44,
    r: -3,
    fields: [
      { label: 'First name' },
      { label: 'Email address' },
      { label: 'Are you authorized to work in…', kind: 'select' },
    ],
  },
  {
    host: 'empleos.solana.example',
    style: 'underline',
    x: 0.78,
    y: -0.48,
    r: 2.5,
    fields: [{ label: 'Nombre' }, { label: 'Correo electrónico' }, { label: 'Teléfono' }],
  },
  {
    host: 'careers.halden.example',
    style: 'filled',
    x: -0.74,
    y: 0.5,
    r: 2,
    fields: [{ label: 'Given name' }, { label: 'LinkedIn URL' }, { label: 'Resume / CV', kind: 'file' }],
  },
  {
    host: 'trabajo.mirador.example',
    style: 'header',
    x: 0.76,
    y: 0.46,
    r: -2,
    fields: [
      { label: 'Perfil de LinkedIn' },
      { label: 'Hoja de vida', kind: 'file' },
      { label: '¿Estás autorizado para trabajar en…?', kind: 'select' },
    ],
  },
] as const;

const f = t.fields;
const profile = [
  [f.firstName, 'Jordan', false],
  [f.email, 'jordan.rivera@example.com', false],
  [f.phone, '+351 912 345 678', true],
  [f.linkedin, '/in/jordan-rivera-dev', false],
  [f.cv, 'jordan-rivera-cv.pdf', false],
  [f.workAuth, f.yes, true],
] as const;
---

<section id="problem" class="relative isolate" aria-labelledby="problem-title">
  <div class="vault-stage" data-vault-stage>
    <div class="vault-sticky section-pad relative" data-vault-sticky>
      <FormSkeleton class="-z-10" />

      <div class="vault-heading container-page text-center" data-vault-heading>
        <p class="eyebrow justify-center">{t.eyebrow}</p>
        <h2 id="problem-title" class="display display-lg mx-auto mt-4 max-w-[46rem]">
          <span class="dim">{t.titleDim}</span><br />{t.title}
        </h2>
        <p class="lead mx-auto mt-5 max-w-[34rem]">{t.lead}</p>
      </div>

      <ul class="vault-frags container-page" aria-label={t.fragsAria}>
        {
          frags.map((f) => (
            <li class:list={['frag', `frag-${f.style}`]} data-x={f.x} data-y={f.y} data-r={f.r} data-frag>
              <p class="frag-host">{f.host}</p>
              <ul class="frag-fields">
                {f.fields.map((field) => (
                  <li class="frag-field">
                    <span class="frag-label">{field.label}</span>
                    <span class:list={['frag-input', 'kind' in field && `frag-input-${field.kind}`]} aria-hidden="true">
                      {'kind' in field && field.kind === 'file' && <span class="frag-attach">Attach</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <div class="vault-result" data-vault-result>
        <div class="card profile-card" data-vault-profile>
          <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3">
            <p class="text-sm font-medium">{t.profile}</p>
            <p class="text-xs text-muted">{t.profileNote}</p>
          </div>
          <dl class="divide-y divide-line">
            {
              profile.map(([k, v, mobileHide]) => (
                <div class:list={['grid grid-cols-[7.25rem_1fr] gap-3 px-4 py-2 text-[0.8125rem]', mobileHide && 'max-md:hidden']}>
                  <dt class="text-muted">{k}</dt>
                  <dd class="truncate text-fg">{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="vault-link" data-vault-link aria-hidden="true">
          <span class="vault-link-line" data-vault-line></span>
          <span class="vault-link-tag">{t.savedTo}</span>
        </div>

        <figure class="vault-file" data-vault-file>
          <div class="vault-file-doc" aria-hidden="true">
            <span class="vault-file-fold"></span>
            <Icon name="FileJson" class="size-7 text-accent" strokeWidth={1.75} />
          </div>
          <figcaption class="mt-3 text-center">
            <code class="block text-sm font-medium text-fg">profile.json</code>
            <span class="mt-0.5 block text-xs text-muted">{t.fileNote}</span>
          </figcaption>
        </figure>
      </div>

      <div class="vault-outro container-page mt-12 text-center" data-vault-outro>
        <p class="display display-md mx-auto max-w-[44rem]">
          <span class="dim">{t.outroDim}</span>{' '}{t.outro}
        </p>
        <p class="lead mx-auto mt-4 max-w-[38rem]">{t.outroLead}</p>
      </div>
    </div>
  </div>
</section>
