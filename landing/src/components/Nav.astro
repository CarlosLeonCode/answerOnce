---
import Brand from './Brand.astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { tools } from '../tools';
import { site } from '../site';
import { installHref } from '../downloads';

// Section links are relative to the home page, so they also work from /install/.
const home = Astro.url.pathname === '/';
const at = (hash: string) => (home ? hash : `/${hash}`);
const onInstall = Astro.url.pathname.startsWith('/install');
const links = [
  { href: at('#how-it-works'), label: 'How it works' },
  { href: at('#features'), label: 'Features' },
  { href: at('#privacy'), label: 'Privacy' },
  { href: '/install/', label: 'Install guide', current: onInstall },
  { href: at('#faq'), label: 'FAQ' },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="pointer-events-none absolute inset-0 border-b border-line bg-[#fafafa]/80 backdrop-blur-xl" aria-hidden="true"></div>
  <nav class="container-page relative flex h-16 items-center justify-between gap-6 sm:h-[4.5rem]" aria-label="Main">
    <a href={home ? '#top' : '/'} class="rounded-lg" aria-label="AnswerOnce home"><Brand /></a>
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="rounded-full px-3 py-2 text-sm text-muted transition-colors hover:text-fg aria-[current=page]:text-fg aria-[current=page]:font-medium lg:px-3.5"
              aria-current={l.current ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="group relative">
        <button
          type="button"
          class="flex items-center gap-1 rounded-full px-3 py-2 text-sm text-muted transition-colors group-focus-within:text-fg group-hover:text-fg lg:px-3.5"
          aria-haspopup="true"
        >
          Tools<Icon name="ChevronDown" class="size-3.5 transition-transform group-focus-within:rotate-180 group-hover:rotate-180" />
        </button>
        <div class="invisible absolute top-full left-1/2 w-80 -translate-x-1/2 pt-2 opacity-0 transition-[opacity,visibility] duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
          <ul class="rounded-2xl border border-line bg-white p-1.5 shadow-[0_20px_50px_-20px_rgb(17_17_40/0.35)]">
            {
              tools.map((p) => (
                <li>
                  <a href={p.href} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-xl p-2 transition-colors hover:bg-surface-2 focus-visible:bg-surface-2">
                    <Image src={p.icon} alt="" width={32} height={32} class="size-8 flex-none rounded-lg border border-line" />
                    <span class="min-w-0">
                      <span class="block text-sm font-medium text-fg">{p.name}</span>
                      <span class="block truncate text-xs text-muted">{p.text}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </li>
      {
        site.repoUrl && (
          <li>
            <a href={site.repoUrl} class="rounded-full px-3 py-2 text-sm text-muted transition-colors hover:text-fg" rel="noopener">
              Source
            </a>
          </li>
        )
      }
    </ul>
    <a href={installHref} class="btn btn-ghost btn-sm"><Icon name="Download" />Install</a>
  </nav>
</header>
