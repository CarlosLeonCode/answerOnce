---
import Shot from './Shot.astro';
import importShot from '../assets/shots/import-review-crop-light.png';
import fillShot from '../assets/shots/panel-after-fill-light.png';
import draftShot from '../assets/shots/panel-ai-draft-crop-light.png';

const steps = [
  {
    title: 'Import your CV',
    body: 'Drop your CV and AI fills your profile, or use the basic extractor. You review every value.',
    shot: importShot,
    zoom: true,
    alt: 'Import from CV review step: each extracted field (first name, last name, email, phone, location) is shown next to the current value with a checkbox, and a button to save the changes to the profile.',
  },
  {
    title: 'Fill the application',
    body: 'Press Fill this page. Known fields are filled and your CV is attached.',
    shot: fillShot,
    alt: 'AnswerOnce panel after filling: 9 fields filled, 1 needs input, 0 kept.',
  },
  {
    title: 'Review & submit',
    body: 'Draft open questions with AI, one click each. Then you press Submit.',
    shot: draftShot,
    alt: 'An AI-drafted answer to “Why do you want to work at Fieldstone?” in the AnswerOnce panel, with buttons to generate again, insert into page, or save the answer.',
  },
] as const;
---

<section id="how-it-works" class="section-pad relative" aria-labelledby="how-title">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow justify-center">How it works</p>
      <h2 id="how-title" class="display display-lg mt-4">
        <span class="dim">Set up once.</span><br />Then it takes a click.
      </h2>
    </div>

    <ol class="mt-12 grid gap-4 md:grid-cols-3" data-reveal>
      {
        steps.map((s, i) => (
          <li class="card flex flex-col overflow-hidden">
            <div class="relative h-56 overflow-hidden border-b border-line bg-surface-2 px-6 pt-6 sm:h-60">
              <div class:list={['shot', 'zoom' in s && 'w-[165%] max-w-none']}>
                <Shot src={s.shot} alt={s.alt} class="w-full" sizes={'zoom' in s ? '(min-width: 1088px) 560px, (min-width: 768px) 50vw, 160vw' : '(min-width: 1088px) 340px, (min-width: 768px) 30vw, calc(100vw - 5rem)'} />
              </div>
              <div class="pointer-events-none absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-[#f4f4f6] to-transparent" aria-hidden="true" />
            </div>
            <div class="p-6">
              <p class="flex items-center gap-3">
                <span class="grid size-7 flex-none place-items-center rounded-md bg-[#0b0b0f] text-xs font-medium text-white">{i + 1}</span>
                <span class="text-[1.0625rem] font-medium tracking-tight">{s.title}</span>
              </p>
              <p class="mt-3 text-sm leading-relaxed text-muted">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
