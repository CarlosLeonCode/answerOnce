---
import Icon from './Icon.astro';
import { site } from '../site';
import { downloads, installHref } from '../downloads';
import { fmt, localize, toLocale, useStrings } from '../i18n';

const locale = toLocale(Astro.currentLocale);
const t = useStrings(locale).install;
const guide = localize(locale, '/install/');

// A short preview of the install guide; each item links to its step on /install/.
const preview = (
  [
    { step: 1, icon: 'Download' },
    { step: 2, icon: 'FolderOpen' },
    { step: 5, icon: 'Puzzle' },
    { step: 7, icon: 'FileUser' },
  ] as const
).map((p, i) => ({ ...p, title: t.preview[i] }));
---

<section id="install" class="section-pad relative" aria-labelledby="install-title">
  <div class="container-page grid items-center gap-x-14 gap-y-8 lg:grid-cols-[1fr_1fr]">
    <div class="min-w-0" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="install-title" class="display display-md mt-4"><span class="dim">{t.titleDim}</span><br />{t.title}</h2>
      <p class="lead mt-4">{t.lead}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href={installHref(locale)} class="btn btn-dark w-full sm:w-auto"><Icon name="Download" />{t.download}</a>
        <a href={guide} class="btn btn-ghost w-full sm:w-auto">{t.guide}<Icon name="ArrowRight" /></a>
      </div>
      <p class="mt-4 text-sm text-muted">
        {fmt(t.version, { version: downloads.version })}{downloads.extension.size && ` · ${downloads.extension.size}`} · {t.chromium}
        {
          site.repoUrl && (
            <>
              {' · '}
              <a href={site.repoUrl} class="underline decoration-line-strong underline-offset-4 hover:text-fg" rel="noopener">
                {t.source}
              </a>
            </>
          )
        }
      </p>
    </div>

    <ol class="card min-w-0 divide-y divide-line" data-reveal aria-label={t.previewAria}>
      {
        preview.map((p) => (
          <li>
            <a href={`${guide}#step-${p.step}`} class="group flex items-center gap-4 p-4 sm:px-6">
              <span class="grid size-8 flex-none place-items-center rounded-md bg-[#0b0b0f] text-sm font-medium text-white">{p.step}</span>
              <span class="min-w-0 flex-1 font-medium">{p.title}</span>
              <span class="icon-tile size-8 transition-colors group-hover:bg-white">
                <Icon name={p.icon} class="size-4" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
