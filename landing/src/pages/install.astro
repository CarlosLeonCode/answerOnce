---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Step from '../components/install/Step.astro';
import For from '../components/install/For.astro';
import Mock from '../components/install/Mock.astro';
import { browsers } from '../browsers';
import { downloads } from '../downloads';
import { site } from '../site';

const zip = downloads.extension;
const mcpb = downloads.mcpb;
const TOTAL = 8;
const stepTitles = [
  'Download the file',
  'Unzip it',
  'Open the extensions page',
  'Turn on Developer mode',
  'Load the folder',
  'Pin AnswerOnce',
  'Create your profile',
  'Connect Claude',
];

const faqs = [
  {
    q: 'I can’t find “Load unpacked”',
    a: 'Developer mode is off. Switch it on (step 4) and the Load unpacked button appears at the top of the extensions page.',
  },
  {
    q: '“Manifest file is missing or unreadable”',
    a: 'You selected the zip, or a folder one level too high or too low. Unzip first, then select the answeronce-chrome folder: the one that has manifest.json directly inside it.',
  },
  {
    q: 'How do I update AnswerOnce?',
    a: 'Download the new zip and unzip it. Replace the contents of your existing answeronce-chrome folder with the new files, then click the reload icon on AnswerOnce’s card on the extensions page. Loading a different folder installs a second copy. Your profile stays in its own folder either way.',
  },
  {
    q: 'The side panel doesn’t show up in Arc',
    a: 'Arc has no side panel for extensions, so AnswerOnce opens as a floating panel inside the page you are on. Everything else works the same.',
  },
  {
    q: 'Brave says it can’t open a folder',
    a: 'Brave turns off folder access for websites and extensions by default. Open brave://flags, search for “File System Access”, enable it and relaunch Brave.',
  },
];
---

<Base
  title="Install AnswerOnce — step-by-step guide"
  description="Download AnswerOnce and load it in Chrome, Arc, Edge or Brave in eight short steps. No Chrome Web Store needed."
>
  <Nav />
  <main id="main" class="install-guide">
    <!-- Before the steps are parsed: pick the browser wording (saved choice, else a guess) so nothing flips after paint. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var ids = ['chrome', 'arc', 'edge', 'brave'];
        var b;
        try {
          b = JSON.parse(localStorage.getItem('answeronce:install-guide') || '{}').browser;
        } catch (e) {}
        if (ids.indexOf(b) < 0) {
          var ua = navigator.userAgent;
          var brands = ((navigator.userAgentData && navigator.userAgentData.brands) || [])
            .map(function (x) {
              return x.brand;
            })
            .join(' ');
          b = /Edg\//.test(ua) || /Edge/.test(brands) ? 'edge' : navigator.brave || /Brave/.test(brands) ? 'brave' : 'chrome';
          d.setAttribute('data-browser-auto', '');
        }
        d.setAttribute('data-browser', b);
      })();
    </script>

    <section class="container-page pt-28 pb-10 sm:pt-36 sm:pb-14" aria-labelledby="install-title">
      <div class="grid items-end gap-x-14 gap-y-8 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="min-w-0">
          <p class="eyebrow">Install guide</p>
          <h1 id="install-title" class="display display-lg mt-4">
            <span class="dim">Install AnswerOnce</span><br />in about two minutes.
          </h1>
          <p class="lead mt-5 max-w-[38rem]">
            AnswerOnce is not on the Chrome Web Store yet, so you load it yourself. Follow the steps below and tick each one off
            as you go. Your progress is kept on this device.
          </p>
        </div>

        <div class="card min-w-0 p-5 sm:p-6">
          <div class="flex items-center gap-3.5">
            <span class="mk-zip mk-zip-lg flex-none" aria-hidden="true"></span>
            <div class="min-w-0">
              <p class="truncate font-mono text-[0.9375rem] font-medium">{zip.file}</p>
              <p class="mt-0.5 text-sm text-muted">
                Version {downloads.version}{zip.size && ` · ${zip.size}`} · Chrome, Arc, Edge, Brave
              </p>
            </div>
          </div>

          <!-- Shown by the script below when the page was opened with ?download=1. -->
          <div class="dl-banner mt-5" role="status" hidden data-dl-banner>
            <Icon name="CircleCheck" class="mt-0.5 size-5 flex-none text-success" />
            <p>
              Your download has started. Didn’t start?
              <a href={zip.href} download={zip.file} class="font-medium text-fg underline underline-offset-4">Download again</a>
            </p>
          </div>
          <a href={zip.href} download={zip.file} class="btn btn-dark mt-5 w-full" data-dl-button>
            <Icon name="Download" />Download AnswerOnce
          </a>
          <a href={zip.href} download={zip.file} hidden tabindex="-1" aria-hidden="true" data-dl-auto></a>
          <script is:inline>
            (function () {
              var params = new URLSearchParams(location.search);
              if (params.get('download') !== '1') return;
              var banner = document.querySelector('[data-dl-banner]');
              var button = document.querySelector('[data-dl-button]');
              if (banner) banner.hidden = false;
              if (button) button.hidden = true;
              var auto = document.querySelector('[data-dl-auto]');
              if (auto) auto.click();
              // Drop the parameter so a reload does not download again.
              params.delete('download');
              var q = params.toString();
              history.replaceState(history.state, '', location.pathname + (q ? '?' + q : '') + location.hash);
            })();
          </script>

          <p class="mt-4 text-[0.8125rem] leading-relaxed text-muted">
            Needs a desktop Chromium browser, version 116 or newer.{' '}
            {
              site.repoUrl && (
                <>
                  Prefer to build it?{' '}
                  <a href="#build-from-source" class="underline decoration-line-strong underline-offset-4 hover:text-fg">
                    Build from source
                  </a>
                  .
                </>
              )
            }
          </p>
        </div>
      </div>

      <p class="env-note mt-6" hidden data-env-note>
        <Icon name="TriangleAlert" class="mt-0.5 size-5 flex-none text-warning" />
        <span data-env-text></span>
      </p>
    </section>

    <section class="container-page pb-16 sm:pb-24" aria-label="Install steps">
      <div class="grid gap-8 lg:grid-cols-[16.5rem_minmax(0,1fr)] lg:gap-10">
        <aside class="min-w-0">
          <div class="card guide-side p-5">
            <fieldset class="js-only">
              <legend class="text-sm font-medium">Your browser</legend>
              <div class="browser-picker mt-3">
                {
                  browsers.map((b) => (
                    <label class="browser-opt">
                      <input type="radio" name="browser" value={b.id} checked={b.id === 'chrome'} />
                      <span>{b.name}</span>
                    </label>
                  ))
                }
              </div>
              <p class="mt-2.5 text-xs text-muted" data-browser-hint>The steps below use its wording.</p>
            </fieldset>

            <div class="js-only mt-6 border-t border-line pt-5">
              <div class="flex items-baseline justify-between gap-3">
                <p class="text-sm font-medium" id="progress-label">Progress</p>
                <p class="text-sm text-muted tabular-nums" data-progress-text aria-hidden="true">0 of {TOTAL}</p>
              </div>
              <div
                class="progress mt-2.5"
                role="progressbar"
                aria-labelledby="progress-label"
                aria-valuemin="0"
                aria-valuemax={TOTAL}
                aria-valuenow="0"
                aria-valuetext={`0 of ${TOTAL} steps done`}
                data-progress
              >
                <span class="progress-fill" data-progress-fill></span>
              </div>

              <ol class="guide-index mt-4">
                {
                  stepTitles.map((t, i) => (
                    <li>
                      <a href={`#step-${i + 1}`} data-index={i + 1}>
                        <span class="guide-dot" aria-hidden="true" />
                        {t}
                      </a>
                    </li>
                  ))
                }
              </ol>

              <button type="button" class="btn btn-ghost btn-sm mt-5 w-full" data-reset>
                <Icon name="RotateCcw" />Start over
              </button>
              <p class="sr-only" aria-live="polite" data-announce></p>
            </div>

            <noscript>
              <p class="text-sm leading-relaxed text-muted">
                The steps use Chrome’s wording. In Arc, Edge or Brave, open <code class="kbd">arc://extensions</code>,
                <code class="kbd">edge://extensions</code> or <code class="kbd">brave://extensions</code> instead.
              </p>
            </noscript>
          </div>
        </aside>

        <div class="min-w-0">
          <ol class="steps-list">
            <Step n={1} title={stepTitles[0]}>
              <p>
                Click <strong>Download AnswerOnce</strong> above. Your browser saves <code class="kbd">{zip.file}</code>
                {zip.size && ` (${zip.size})`} to your Downloads folder.
              </p>
              <a href={zip.href} download={zip.file} class="btn btn-ghost btn-sm mt-1">
                <Icon name="Download" />Download {zip.file}
              </a>
              <Mock slot="mock" kind="download" />
            </Step>

            <Step n={2} title={stepTitles[1]}>
              <p>
                Double-click the zip and you get a folder named <code class="kbd">answeronce-chrome</code>. Move it somewhere
                permanent, like Documents: the browser loads AnswerOnce from that folder every time, so keep it there.
              </p>
              <p class="step-note">On Windows, right-click the zip and choose <strong>Extract All</strong>.</p>
              <Mock slot="mock" kind="unzip" />
            </Step>

            <Step n={3} title={stepTitles[2]}>
              <p>
                Open a new tab, paste this address and press Enter. Browsers don’t let web pages link to it, so copy it
                instead.
              </p>
              <div class="url-box">
                <code class="url-text">
                  {browsers.map((b) => <For b={b.id}>{b.extensionsUrl}</For>)}
                </code>
                <button
                  type="button"
                  class="copy-btn hidden h-8 flex-none items-center gap-1.5 rounded-lg border border-line-strong bg-white px-2.5 text-xs font-medium text-fg-2 transition-colors hover:text-fg"
                  data-copy="chrome://extensions"
                  data-url-copy
                  aria-label="Copy address: chrome://extensions"
                >
                  <Icon name="Copy" class="size-3.5" />
                  <span class="copy-label" aria-live="polite">Copy</span>
                </button>
              </div>
              <p class="step-note">
                <For b="chrome">Or open the <strong>⋮</strong> menu → <strong>Extensions</strong> → <strong>Manage Extensions</strong>.</For>{' '}
                <For b="arc">In Arc, press <kbd class="kbd">⌘T</kbd>, paste the address and press Enter.</For>{' '}
                <For b="edge">Or open the <strong>…</strong> menu → <strong>Extensions</strong> → <strong>Manage extensions</strong>.</For>{' '}
                <For b="brave">Or open the <strong>≡</strong> menu → <strong>Extensions</strong>.</For>{' '}
              </p>
              <Mock slot="mock" kind="open" />
            </Step>

            <Step n={4} title={stepTitles[3]}>
              <p>
                <For b="chrome arc brave">Switch on <strong>Developer mode</strong> in the top right corner of the extensions page.</For>{' '}
                <For b="edge">Switch on <strong>Developer mode</strong> in the left sidebar of the extensions page.</For>{' '}
                It lets the browser load an extension from a folder on your computer.
              </p>
              <Mock slot="mock" kind="devmode" />
            </Step>

            <Step n={5} title={stepTitles[4]}>
              <p>
                Click <strong>Load unpacked</strong>, which appears once Developer mode is on. Choose the{' '}
                <code class="kbd">answeronce-chrome</code> folder from step 2 (the folder, not the zip) and click{' '}
                <strong>Select</strong>.
              </p>
              <p class="step-note">AnswerOnce’s card then shows up in the list of extensions.</p>
              <Mock slot="mock" kind="load" />
            </Step>

            <Step n={6} title={stepTitles[5]}>
              <p>
                <For b="chrome brave">Click the puzzle-piece icon next to the address bar, then the pin next to AnswerOnce.</For>{' '}
                <For b="edge">Click the puzzle-piece icon in the toolbar, then the eye icon next to AnswerOnce (Show in toolbar).</For>{' '}
                <For b="arc">Click the puzzle-piece icon at the top of the sidebar, then pin AnswerOnce.</For>{' '}
                Its icon stays one click away on every job application.
              </p>
              <Mock slot="mock" kind="pin" />
            </Step>

            <Step n={7} title={stepTitles[6]}>
              <p>
                Click the AnswerOnce icon, then <For b="arc"><strong>Open settings</strong> and</For>{' '}<strong>Choose folder…</strong> and pick a new folder for your data, such as
                <code class="kbd">Documents/answeronce</code> (not the extension folder). Click <strong>Create profile</strong>,
                then <strong>Import your CV</strong> to fill it in one step.
              </p>
              <p class="step-note">
                <For b="chrome edge brave">AnswerOnce opens in the browser’s side panel.</For>{' '}
                <For b="arc">In Arc, AnswerOnce opens as a floating panel inside the page.</For>{' '}
                <For b="brave">Brave blocks folder access by default; see the troubleshooting section below.</For>{' '}
                You can also skip the import and fill your profile by hand.
              </p>
              <Mock slot="mock" kind="firstrun" />
            </Step>

            <Step n={8} title={stepTitles[7]} optional>
              <p>
                Download <code class="kbd">{mcpb.file}</code>, open it with Claude Desktop, click <strong>Install</strong> and
                choose your profile folder. Using Claude Code, Codex, Antigravity, OpenCode or Cursor instead? Open{' '}
                <strong>Settings → AI agents</strong> in AnswerOnce and follow the steps for your agent (needs Node.js 22.13 or newer).
              </p>
              <a href={mcpb.href} download={mcpb.file} class="btn btn-ghost btn-sm mt-1">
                <Icon name="Download" />Download {mcpb.file}{mcpb.size && ` (${mcpb.size})`}
              </a>
              <Mock slot="mock" kind="claude" />
            </Step>
          </ol>

          <div class="card guide-finish mt-6 p-5 sm:p-6" data-finish>
            <span class="icon-tile"><Icon name="Sparkles" /></span>
            <div class="min-w-0">
              <h3 class="font-medium">That’s it. Go apply.</h3>
              <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">
                Open any job application, click the AnswerOnce icon and press <strong class="text-fg-2">Fill this page</strong>.
                Review the form and submit it yourself.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="troubleshooting" class="section-pad border-t border-line" aria-labelledby="trouble-title">
      <div class="container-page grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
        <div>
          <p class="eyebrow">Troubleshooting</p>
          <h2 id="trouble-title" class="display display-md mt-4"><span class="dim">Stuck?</span><br />Start here.</h2>
          {
            site.repoUrl && (
              <p class="lead mt-4">
                Still stuck?{' '}
                <a href={`${site.repoUrl}/issues`} class="text-fg underline decoration-line-strong underline-offset-4" rel="noopener">
                  Open an issue
                </a>{' '}
                and say which browser and step.
              </p>
            )
          }
        </div>

        <div class="card divide-y divide-line overflow-hidden">
          {
            faqs.map((f) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium transition-colors hover:bg-surface-2 sm:px-6 [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <Icon name="ChevronDown" class="size-5 flex-none text-muted transition-transform group-open:rotate-180" />
                </summary>
                <p class="px-5 pb-5 text-[0.9375rem] leading-relaxed text-muted sm:px-6">{f.a}</p>
              </details>
            ))
          }
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium transition-colors hover:bg-surface-2 sm:px-6 [&::-webkit-details-marker]:hidden">
              Using Ollama for local AI?
              <Icon name="ChevronDown" class="size-5 flex-none text-muted transition-transform group-open:rotate-180" />
            </summary>
            <div class="px-5 pb-5 sm:px-6">
              <p class="text-[0.9375rem] leading-relaxed text-muted">
                Ollama rejects requests from browser extensions unless their origin is allowed. Set
                <code class="kbd">OLLAMA_ORIGINS</code>, restart Ollama, then pick Ollama in Settings → AI provider.
              </p>
              <div class="mt-4 space-y-2.5">
                <CodeBlock label="macOS app" code={'launchctl setenv OLLAMA_ORIGINS "chrome-extension://*"'} />
                <CodeBlock label="Running the server yourself" code={'OLLAMA_ORIGINS="chrome-extension://*" ollama serve'} />
              </div>
            </div>
          </details>
          {
            site.repoUrl && (
              <details class="group" id="build-from-source">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium transition-colors hover:bg-surface-2 sm:px-6 [&::-webkit-details-marker]:hidden">
                  Prefer to build from source?
                  <Icon name="ChevronDown" class="size-5 flex-none text-muted transition-transform group-open:rotate-180" />
                </summary>
                <div class="px-5 pb-5 sm:px-6">
                  <p class="text-[0.9375rem] leading-relaxed text-muted">
                    Clone{' '}
                    <a href={site.repoUrl} class="text-fg underline decoration-line-strong underline-offset-4" rel="noopener">
                      the source code
                    </a>{' '}
                    (Node 24+, pnpm 10) and build it. Then follow steps 3 to 7 and select the{' '}
                    <code class="kbd">.output/chrome-mv3</code> folder in step 5.
                  </p>
                  <div class="mt-4">
                    <CodeBlock code={'pnpm install\npnpm build'} />
                  </div>
                </div>
              </details>
            )
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/install';
</script>
